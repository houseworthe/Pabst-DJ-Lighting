#!/bin/bash
# lightctl — Control the lighting daemon
# Usage: lightctl start|stop|status|scene <name>|strobe|blackout|warm|bpm <n>

SOCKET="/tmp/lightd.sock"
DAEMON="$HOME/.openclaw/workspace-main/projects/dj-lights/lightd.py"

case "${1:-}" in
  daemon)
    # Start the daemon process itself
    shift
    exec python3 "$DAEMON" "$@"
    ;;
  ""|help|-h|--help)
    echo "lightctl — DJ Lighting Control"
    echo ""
    echo "  lightctl daemon [--no-audio]  Start the daemon"
    echo "  lightctl start                Enable auto mode (audio-reactive)"
    echo "  lightctl stop                 Stop scenes, warm idle"
    echo "  lightctl status               Show current state"
    echo "  lightctl scene <name>         Run specific scene"
    echo "  lightctl scenes [category]    List available scenes"
    echo "  lightctl strobe [speed]       Full strobe (default 180)"
    echo "  lightctl blackout             All lights off"
    echo "  lightctl warm                 Warm idle"
    echo "  lightctl brightness <0-100>   Override brightness"
    echo "  lightctl bpm <num|auto>       Set BPM (or auto-detect)"
    echo "  lightctl govee on|off         Toggle Govee lights"
    echo "  lightctl quit                 Stop daemon"
    exit 0
    ;;
  *)
    # Send command to daemon via socket
    if [ ! -S "$SOCKET" ]; then
      echo "ERR: lightd not running. Start with: lightctl daemon"
      exit 1
    fi
    echo "$*" | nc -U "$SOCKET" -w 2
    ;;
esac
